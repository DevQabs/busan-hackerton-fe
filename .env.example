# Copy this file to .env.local and fill in the real value for local dev.
# In Vercel: Project Settings > Environment Variables > add the same key.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── 카카오 (배차 예약 페이지 /booking) ───────────────────────────────────
# REST API 키 하나로 서버에서 두 가지를 호출한다:
#   app/api/places      장소·주소 검색 (Local API)
#   app/api/directions  자동차 길찾기 (Mobility API)
# NEXT_PUBLIC_ 을 붙이지 말 것 — 붙이면 키가 클라이언트 번들로 새어 나간다.
# 카카오 콘솔의 "호출 허용 IP"는 비워둔다 (Vercel 아웃바운드 IP는 고정이 아니다).
# 미설정이어도 페이지는 뜨며, 검색은 오류를 표시하고 경로는 직선으로 폴백한다.
KAKAO_REST_KEY=
